# Copy to .env.local and fill in your values
# Never commit .env.local to git

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.powerbipro.agency
NEXT_PUBLIC_SITE_NAME=PowerBI Pro Agency

# Calendly
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link

# Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Contact Email
NEXT_PUBLIC_CONTACT_EMAIL=hello@powerbiproagency.com

# Google Form (embed URL)
NEXT_PUBLIC_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform?embedded=true

# Optional: Mailchimp API for newsletter
MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_LIST_ID=your-list-id
MAILCHIMP_API_SERVER=us1

# Optional: Resend (free email sending)
RESEND_API_KEY=re_your-resend-key
