# ─────────────────────────────────────────────────────────────────────────────
# DataZeb — Docker environment file
# Copy to .env and fill in your values:
#   cp .env.docker.example .env
#
# This file is read by docker-compose.yml automatically.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=datazeb_cms
POSTGRES_USER=strapi
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_MIN_32_CHARS

# ── Strapi Secrets ────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 32
STRAPI_APP_KEYS=key1base64==,key2base64==,key3base64==,key4base64==
STRAPI_API_TOKEN_SALT=CHANGE_THIS_32_CHAR_RANDOM_STRING
STRAPI_ADMIN_JWT_SECRET=CHANGE_THIS_32_CHAR_RANDOM_STRING
STRAPI_TRANSFER_TOKEN_SALT=CHANGE_THIS_32_CHAR_RANDOM_STRING
STRAPI_JWT_SECRET=CHANGE_THIS_32_CHAR_RANDOM_STRING

# ── Shared Secret (Strapi → Next.js revalidation) ─────────────────────────────
# Must be the same in both services
REVALIDATE_SECRET=CHANGE_THIS_SHARED_SECRET_MIN_32_CHARS

# ── Next.js Runtime ───────────────────────────────────────────────────────────
# Generated in Strapi admin → Settings → API Tokens (Read-only)
STRAPI_TOKEN=paste-your-strapi-read-only-api-token-here

# ── Public Next.js vars (baked into build — set before docker compose build) ──
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link
NEXT_PUBLIC_CONTACT_EMAIL=hello@datazeb.com
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
